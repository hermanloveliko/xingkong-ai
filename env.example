# ─────────────────────────────────────────────────────────────────────────────
# 星空AI 网站后端 · 环境变量配置模板
# 将本文件复制并重命名为 .env.local，填写真实值后启动服务
# 命令：copy env.example .env.local (Windows) / cp env.example .env.local (Mac/Linux)
# !! 切勿将 .env.local 提交到 Git !!
# ─────────────────────────────────────────────────────────────────────────────

# ── 服务器端口 ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── 密码加盐（生产环境必须修改！改后所有旧密码失效需重置）──────────────────
PASSWORD_SALT=nebula_xingkong_2026_salt_CHANGE_IN_PROD

# ── 管理员账户（生产环境必须设置强密码）──────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_TOKEN=your_random_32char_api_token

# ── 跨域白名单（生产环境改为实际域名，多个用英文逗号分隔）─────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── SQLite 数据库路径（可选，默认 data/app.db）──────────────────────────────
# DB_FILE=data/app.db

# ─────────────────────────────────────────────────────────────────────────────
# 阿里云短信服务（填写后短信将真实发送；不填则开发模式仅打印验证码到控制台）
# 申请地址：https://dysms.console.aliyun.com/
# ─────────────────────────────────────────────────────────────────────────────
ALIYUN_SMS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_SMS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SMS_SIGN_NAME=星空AI
ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXXXX

