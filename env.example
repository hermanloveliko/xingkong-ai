# ─────────────────────────────────────────────────────────────────────────────
# 星空AI 网站后端 · 环境变量配置模板
# 
# 【使用方法】
#   Windows: copy env.example .env.local
#   Linux:   cp env.example .env.local
#   然后编辑 .env.local 填写真实值
#
# !! 切勿将 .env.local 提交到 Git（已加入 .gitignore）!!
# ─────────────────────────────────────────────────────────────────────────────

# ── 运行环境 ──────────────────────────────────────────────────────────────────
PORT=4000
# 生产环境必须改为 production（会启用静态文件托管、关闭调试日志）
NODE_ENV=development

# ── 密码加盐（⚠️ 生产环境必须修改！改后所有旧密码失效需重置）──────────────
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_SALT=nebula_xingkong_2026_salt_CHANGE_IN_PROD

# ── 管理员账户（⚠️ 生产环境必须设置强密码）──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_min12chars
# 生成 TOKEN：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your_random_64char_hex_token

# ── 跨域白名单（生产环境改为实际域名，多个用英文逗号分隔，不加斜杠）────────
# 开发环境
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
# 生产环境示例（取消注释并修改）：
# ALLOWED_ORIGINS=https://你的域名.com,https://www.你的域名.com

# ── SQLite 数据库路径（可选，默认 data/app.db）──────────────────────────────
# DB_FILE=data/app.db

# ─────────────────────────────────────────────────────────────────────────────
# 阿里云短信服务（⚠️ 上线必填，否则验证码只打印到控制台不发短信）
#
# 获取方式：
#   1. 登录 https://dysms.console.aliyun.com/
#   2. 签名管理 → 添加签名（需营业执照，审核约1工作日）
#   3. 模板管理 → 添加模板 → 审核通过后获得模板CODE
#   4. 右上角头像 → AccessKey管理 → 创建AccessKey
# ─────────────────────────────────────────────────────────────────────────────
ALIYUN_SMS_ACCESS_KEY_ID=LTAI5t你的AccessKeyId
ALIYUN_SMS_ACCESS_KEY_SECRET=你的AccessKeySecret64位
# 短信签名（在控制台申请，必须与申请通过的签名完全一致）
ALIYUN_SMS_SIGN_NAME=星空AI
# 短信模板CODE（格式：SMS_XXXXXXXXX）
# 模板内容建议：您的星空AI验证码为${code}，5分钟内有效，请勿泄露。
ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# 微信支付（ICP备案通过后接入）
# 申请地址：https://pay.weixin.qq.com/
# ─────────────────────────────────────────────────────────────────────────────
# WECHAT_PAY_MCH_ID=你的商户号
# WECHAT_PAY_APP_ID=你的APPID
# WECHAT_PAY_API_KEY=你的APIv3密钥
# WECHAT_PAY_SERIAL_NO=你的证书序列号
# WECHAT_PAY_NOTIFY_URL=https://你的域名.com/api/pay/notify
